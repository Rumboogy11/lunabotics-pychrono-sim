+// Conservative bounds used to skip ray tests against triangle groups that cannot be hit.
+struct MeshRayBounds {
+    ChVector3d min;
+    ChVector3d max;
+};
+
+struct MeshRayNode {
+    MeshRayBounds bounds;
+    int first = 0;
+    int count = 0;
+    int left = -1;
+    int right = -1;
+};
+
+// Slab test with the padded triangle bounds.  The two ray directions used below have no zero components; starting at
+// tmin = 0 keeps all triangles in front of (or straddling) the ray origin as candidates.
+inline bool RayHitsMeshBounds(const MeshRayBounds& bounds,
+                              const ChVector3d& origin,
+                              const ChVector3d& inv_dir,
+                              const ChVector3d& pad) {
+    double tmin = 0;
+    double tmax = std::numeric_limits<double>::infinity();
+    for (int axis = 0; axis < 3; ++axis) {
+        double t0 = (bounds.min[axis] - pad[axis] - origin[axis]) * inv_dir[axis];
+        double t1 = (bounds.max[axis] + pad[axis] - origin[axis]) * inv_dir[axis];
+        if (t0 > t1)
+            std::swap(t0, t1);
+        tmin = std::max(tmin, t0);
+        tmax = std::min(tmax, t1);
+        if (tmin > tmax)
+            return false;
+    }
+    return tmax >= 0;
+}
