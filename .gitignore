study_gui_defaults.json
study_gui_settings.json

# Python bytecode and caches.
__pycache__/
*.py[cod]

# Temporary mesher files and crash dumps.
tetgen-tmpfile_*
core
core.*

# Editor/OS files.
.DS_Store
*.swp
*.swo
