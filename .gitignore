# Local build trees, virtual environments, and installed Chrono artifacts.
# These are regenerated with environment/*.sh and environment/copy_tree_two_pass.py.
chrono-build/
chrono-env/
chrono-install/
chrono-src/
pychrono-env/

# The installer may replace the paths above with symlinks to a native work root.
/chrono-build
/chrono-env
/chrono-install
/chrono-src
/.tools
/.mamba

# Installer-managed tool downloads and conda package cache.
.tools/
.mamba/

# Simulation output and large generated result sets.
/Output*/
output/
geometry_checks/

# Local CAD/geometry assets (not source-controlled).
/geometry/

# User-edited GUI defaults (workspace-local, regenerated from shipped values).
study_gui_defaults.json
study_gui_settings.json

# Python bytecode and caches.
__pycache__/
*.py[cod]

# Temporary mesher files and crash dumps.
tetgen-tmpfile_*
core
core.*

# Editor/OS files.
.DS_Store
*.swp
*.swo
